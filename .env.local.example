# Neon Postgres — API key + account store
# Use the pooled (-pooler) hostname; PgBouncer is required for serverless.
DATABASE_URL=

# CongressWatch data source (static JSON served from Vercel CDN)
CONGRESS_DATA_URL=https://congresswatch.vercel.app/data

# Neon Auth (Managed BetterAuth) — user accounts, email verification, OAuth
# Base URL comes from: neonctl neon-auth status --project-id <id>
# Cookie secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Redis — rate limiting. Provision via the Vercel marketplace, then `vercel env pull`.
# Either naming convention works: Vercel KV injects KV_REST_API_*, a direct Upstash
# integration injects UPSTASH_REDIS_REST_*.
# OPTIONAL: if unset, rate limiting is skipped (requests are allowed) rather than failing.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend — API key delivery email
RESEND_API_KEY=

# Base URL
API_BASE_URL=https://api.opensourceforall.com
